---
// DdayLiberationMap.astro — Leaflet map script for D-Day landings and Allied advance to Paris
// HTML container is generated by the remark plugin via [map:dday-liberation] in markdown.
---

<script>
  import { initMap } from '../scripts/maps/shared-map';
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';
  import 'tippy.js/dist/tippy.css';
  import 'tippy.js/animations/shift-away.css';

  (() => {
    function tooltip(html) {
      return `<div style="font-size:0.8rem;line-height:1.4">${html}</div>`;
    }

    const map = initMap('dday-liberation-map', { center: [48.5, -0.5], zoom: 7 });
    if (!map) return;

    // ── D-Day beaches ──
    const beaches = [
      { name: 'Utah Beach', coords: [49.4300, -1.1600], desc: '4e division d\'infanterie américaine. 23 000 hommes débarqués.', color: '#3b82f6' },
      { name: 'Omaha Beach', coords: [49.3700, -0.8800], desc: '1re et 29e divisions américaines. Plage la plus meurtrière : 2 400 pertes.', color: '#ef4444' },
      { name: 'Gold Beach', coords: [49.3500, -0.5500], desc: '50e division d\'infanterie britannique.', color: '#f59e0b' },
      { name: 'Juno Beach', coords: [49.3400, -0.4000], desc: '3e division canadienne. 15 000 Canadiens débarqués.', color: '#dc2626' },
      { name: 'Sword Beach', coords: [49.2700, -0.3000], desc: '3e division britannique. Objectif Caen, non atteint le 6 juin.', color: '#f59e0b' },
    ];

    for (const beach of beaches) {
      // Beach marker (on the coast)
      L.circleMarker(beach.coords, {
        radius: 12, color: beach.color, weight: 3, fillColor: beach.color, fillOpacity: 0.5,
      }).addTo(map)
        .bindTooltip(tooltip(`<strong style="color:${beach.color}">${beach.name}</strong><br>${beach.desc}`), { sticky: true, className: 'map-tooltip' })
        .bindPopup(tooltip(`<strong style="color:${beach.color}">${beach.name}</strong><br>${beach.desc}`));
      // Beach label
      const labelLat = beach.coords[0] + 0.12;
      L.circleMarker([labelLat, beach.coords[1]], {
        radius: 2, color: beach.color, fillColor: beach.color, fillOpacity: 0.8,
      }).addTo(map);
    }

    // ── Allied advance arrows (Normandy → Paris) ──
    const alliedAdvances = [
      { name: '1re armée US (Bradley)', coords: [
        [49.40, -1.10], [49.30, -1.00], [49.20, -0.80], [49.10, -0.60],
        [49.00, -0.40], [48.90, -0.20], [48.80, 0.10], [48.70, 0.30],
        [48.60, 0.50], [48.50, 0.70], [48.70, 0.90], [48.85, 2.35],
      ], color: '#3b82f6', dash: false },
      { name: '2e armée britannique (Dempsey)', coords: [
        [49.30, -0.50], [49.20, -0.40], [49.15, -0.30], [49.10, -0.20],
        [49.05, -0.10], [49.00, 0.00], [48.95, 0.10], [48.90, 0.20],
        [48.85, 0.30], [48.80, 0.50], [48.85, 0.70], [48.90, 0.90],
        [48.85, 1.10], [48.80, 1.30], [48.85, 1.50], [48.90, 1.70],
        [48.85, 1.90], [48.90, 2.10], [48.85, 2.35],
      ], color: '#f59e0b', dash: false },
      // Operation Dragoon (Southern France)
      { name: 'Débarquement de Provence (15 août)', coords: [
        [43.20, 6.70], [43.40, 6.50], [43.60, 6.30], [43.80, 6.00],
        [44.00, 5.50], [44.30, 5.00], [44.60, 4.50], [45.00, 4.00],
        [45.30, 3.50], [45.60, 3.00], [45.80, 2.50], [46.00, 2.00],
        [46.30, 1.50], [46.50, 1.00], [46.80, 0.50], [47.00, 0.00],
        [47.20, -0.50], [47.50, -1.00],
      ], color: '#8b5cf6', dash: true },
    ];

    for (const advance of alliedAdvances) {
      L.polyline(advance.coords, {
        color: advance.color, weight: 3, opacity: 0.7, dashArray: advance.dash ? '8, 6' : null,
      }).addTo(map)
        .bindTooltip(tooltip(`<strong style="color:${advance.color}">${advance.name}</strong>`), { sticky: true, className: 'map-tooltip' });
    }

    // ── Key locations ──
    const locations = [
      { name: 'Paris', coords: [48.8566, 2.3522], desc: 'Libérée le 25 août 1944. La 2e DB du général Leclerc entre dans Paris.', type: 'city' },
      { name: 'Caen', coords: [49.1829, -0.3707], desc: 'Objectif du 6 juin, pris le 9 juillet après de violents combats.', type: 'battle' },
      { name: 'Cherbourg', coords: [49.6387, -1.6300], desc: 'Port stratégique pris par les Américains le 27 juin 1944.', type: 'battle' },
      { name: 'Saint-Lô', coords: [49.1162, -1.0760], desc: 'Percée américaine fin juillet. Point de départ de l\'avancée vers l\'est.', type: 'battle' },
      { name: 'Le Mans', coords: [48.0061, 0.1996], desc: 'Pris le 8 août 1944 par la 3e armée US de Patton.', type: 'battle' },
      { name: 'Argentan', coords: [48.7440, -0.0170], desc: 'Poche de Falaise-Argentan, fermée le 21 août 1944.', type: 'battle' },
      { name: 'Falaise', coords: [48.8939, -0.1983], desc: 'Poche de Falaise : 100 000 soldats allemands encerclés.', type: 'battle' },
      { name: 'Chartres', coords: [48.4488, 1.4897], desc: 'Pris le 18 août 1944.', type: 'battle' },
      { name: 'Orléans', coords: [47.9029, 1.9089], desc: 'Pris le 16 août 1944.', type: 'battle' },
      { name: 'Sainte-Mère-Église', coords: [49.4085, -1.3162], desc: 'Première ville libérée en Normandie, dans la nuit du 5 au 6 juin.', type: 'battle' },
    ];

    for (const loc of locations) {
      const color = loc.type === 'city' ? '#d4a843' : '#ef4444';
      const radius = loc.type === 'city' ? 9 : 7;
      L.circleMarker(loc.coords, {
        radius, color, weight: 2, fillColor: color, fillOpacity: 0.7,
      }).addTo(map)
        .bindTooltip(tooltip(`<strong style="color:${color}">${loc.name}</strong><br>${loc.desc}`), { sticky: true, className: 'map-tooltip' })
        .bindPopup(tooltip(`<strong style="color:${color}">${loc.name}</strong><br>${loc.desc}`));
    }

    // ── Legend ──
    const legendEl = document.getElementById('dday-liberation-legend-content');
    if (legendEl) {
      legendEl.innerHTML = `
        <div style="display:flex;flex-direction:column;gap:0.25rem;font-size:0.8rem;">
          <span><span style="display:inline-block;width:12px;height:12px;border-radius:50%;background:#3b82f6;opacity:0.5;margin-right:0.4rem;vertical-align:middle;border:2px solid #3b82f6;"></span>Plage du débarquement</span>
          <span><span style="display:inline-block;width:12px;height:3px;background:#3b82f6;margin-right:0.4rem;vertical-align:middle;"></span>Avancée américaine</span>
          <span><span style="display:inline-block;width:12px;height:3px;background:#f59e0b;margin-right:0.4rem;vertical-align:middle;"></span>Avancée britannique</span>
          <span><span style="display:inline-block;width:12px;height:3px;background:#8b5cf6;margin-right:0.4rem;vertical-align:middle;"></span>Débarquement de Provence</span>
          <span><span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:#d4a843;margin-right:0.4rem;vertical-align:middle;"></span>Ville</span>
          <span><span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:#ef4444;margin-right:0.4rem;vertical-align:middle;"></span>Bataille</span>
        </div>
      `;
    }
  })();
</script>

<style>
  :global(.map-tooltip) {
    background: #111827;
    border: 1px solid #1e293b;
    border-radius: 0.5rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
    color: #e2e8f0;
    font-size: 0.8rem;
    padding: 0.35rem 0.6rem;
    white-space: normal;
    max-width: 320px;
  }
  :global(.map-tooltip::before) { border-top-color: #1e293b; }
</style>
