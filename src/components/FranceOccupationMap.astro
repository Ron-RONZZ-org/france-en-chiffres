---
// FranceOccupationMap.astro — Leaflet map script for occupied zone vs free zone (1940-1942)
// HTML container is generated by the remark plugin via [map:france-occupation] in markdown.
---

<script>
  import { initMap } from '../scripts/maps/shared-map';
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';
  import 'tippy.js/dist/tippy.css';
  import 'tippy.js/animations/shift-away.css';

  (() => {
    function tooltip(html) {
      return `<div style="font-size:0.8rem;line-height:1.4">${html}</div>`;
    }

    const map = initMap('france-occupation-map', { center: [46.5, 2.5], zoom: 6 });
    if (!map) return;

    // ── Demarcation line (approximate) ──
    // Line running from Geneva through Tours to the Spanish border
    const demarcationLine = [
      [46.20, 6.15],   // Geneva area
      [46.30, 5.80],   // 
      [46.40, 5.00],
      [46.50, 4.50],
      [46.60, 4.20],
      [46.80, 3.80],
      [47.00, 3.50],
      [47.20, 2.50],
      [47.40, 1.50],
      [47.20, 0.80],
      [46.80, 0.50],
      [46.50, 0.20],
      [46.20, -0.50],
      [46.00, -1.00],
      [45.80, -1.20],
      [45.50, -1.50],
      [45.00, -1.50],  // Spanish border area
    ];

    L.polyline(demarcationLine, {
      color: '#fbbf24', weight: 4, opacity: 0.8, dashArray: '10, 6',
    }).addTo(map).bindTooltip(tooltip('<strong style="color:#fbbf24">Ligne de démarcation</strong><br>Entre zone occupée et zone libre'), { sticky: true, className: 'map-tooltip' });

    // ── Alsace-Lorraine (annexed) ──
    const alsaceLorraine = [
      [49.30, 6.10], [49.20, 7.00], [48.90, 7.30], [48.60, 7.60],
      [48.30, 7.50], [48.00, 7.50], [47.80, 7.30], [47.60, 7.30],
      [47.50, 7.00], [47.60, 6.80], [47.80, 6.60], [48.00, 6.50],
      [48.30, 6.40], [48.60, 6.30], [49.00, 6.20], [49.30, 6.10],
    ];
    L.polygon(alsaceLorraine, {
      color: '#dc2626', weight: 2, fillColor: '#dc2626', fillOpacity: 0.15,
    }).addTo(map).bindTooltip(tooltip('<strong style="color:#dc2626">Alsace-Moselle</strong><br>Annexée de fait au Reich allemand'), { className: 'map-tooltip' });

    // ── Zone occupée (north) semi-transparent polygon ──
    const occupiedZone = [
      // Approximate boundary from north/west coast
      [51.00, 2.00], [51.00, 3.00], [50.50, 4.00], [50.00, 4.50],
      [49.50, 5.50], [49.30, 6.10], // Alsace border
      // Follow demarcation line west
      [49.30, 6.10], [49.00, 6.20], [48.60, 6.30],
      [48.30, 6.40], [48.00, 6.50], [47.80, 6.60],
      [47.60, 6.80], [47.50, 7.00],
      // This is inside the Alsace polygon, so the demarcation continues
      [47.50, 5.50], [47.20, 4.50], [47.00, 3.50],
      [46.80, 3.00], [46.60, 2.50], [46.40, 1.50],
      [46.20, 0.50], [46.00, 0.00], [45.80, -0.50],
      [45.50, -1.00], [45.30, -1.50],
      // Atlantic coast northward
      [45.60, -1.20], [46.00, -1.50], [46.50, -1.80],
      [47.00, -2.00], [47.50, -2.50], [48.00, -2.00],
      [48.50, -2.50], [49.00, -1.50], [49.50, -1.00],
      [50.00, -0.50], [50.50, 0.50], [51.00, 1.50],
      [51.00, 2.00],
    ];
    L.polygon(occupiedZone, {
      color: '#dc2626', weight: 1, fillColor: '#dc2626', fillOpacity: 0.08,
    }).addTo(map).bindTooltip(tooltip('<strong style="color:#dc2626">Zone occupée</strong><br>Nord et Ouest de la France sous administration militaire allemande'), { className: 'map-tooltip' });

    // ── Zone libre (south) ──
    const freeZone = [
      [47.50, 7.00], [47.50, 5.50], [47.20, 4.50], [47.00, 3.50],
      [46.80, 3.00], [46.60, 2.50], [46.40, 1.50], [46.20, 0.50],
      [46.00, 0.00], [45.80, -0.50], [45.50, -1.00], [45.30, -1.50],
      // Spanish border
      [42.50, -1.50], [42.50, 0.00], [42.50, 1.00], [42.50, 2.00],
      [42.50, 3.00], [43.00, 3.50], [43.50, 4.00], [44.00, 4.50],
      [44.50, 5.00], [45.00, 5.50], [45.50, 6.00], [46.00, 6.50],
      [46.20, 6.80], [46.20, 6.15],
      // Follow demarcation line
      [46.30, 5.80], [46.40, 5.00], [46.50, 4.50], [46.60, 4.20],
      [46.80, 3.80], [47.00, 3.50], [47.20, 2.50], [47.40, 1.50],
      [47.20, 0.80], [46.80, 0.50], [46.50, 0.20], [46.20, -0.50],
      [46.00, -1.00], [45.80, -1.20], [45.50, -1.50],
      // Back up to Alsace
      [47.50, 7.00],
    ];
    L.polygon(freeZone, {
      color: '#22c55e', weight: 1, fillColor: '#22c55e', fillOpacity: 0.06,
    }).addTo(map).bindTooltip(tooltip('<strong style="color:#22c55e">Zone libre</strong><br>Sud de la France sous administration de Vichy'), { className: 'map-tooltip' });

    // ── Italian occupation zone ──
    // Small strip along Italian border (after June 1940 armistice)
    const italianZone = [
      [44.00, 6.50], [44.20, 7.00], [44.50, 7.20], [45.00, 7.00],
      [45.50, 7.00], [46.00, 7.00], [46.20, 6.80], [46.20, 6.15],
      [46.00, 6.50], [45.50, 6.00], [45.00, 5.50], [44.50, 5.00],
      [44.00, 4.50], [43.50, 4.00], [43.00, 5.00], [43.50, 6.00],
      [44.00, 6.50],
    ];
    L.polygon(italianZone, {
      color: '#f97316', weight: 1, fillColor: '#f97316', fillOpacity: 0.08,
    }).addTo(map).bindTooltip(tooltip('<strong style="color:#f97316">Zone d\'occupation italienne</strong><br>Contrôlée par l\'Italie fasciste après juin 1940'), { className: 'map-tooltip' });

    // ── Key locations ──
    const locations = [
      { name: 'Paris', coords: [48.8566, 2.3522], desc: 'Capitale française, en zone occupée. Les Allemands y entrent le 14 juin 1940.', type: 'occupied' },
      { name: 'Vichy', coords: [46.1275, 3.4267], desc: 'Capitale de l\'État français (zone libre). Siège du gouvernement Pétain.', type: 'free' },
      { name: 'Bordeaux', coords: [44.8378, -0.5792], desc: 'Gouvernement français replié en juin 1940.', type: 'free' },
      { name: 'Lyon', coords: [45.7640, 4.8357], desc: 'Plus grande ville de zone libre. Centre de la Résistance.', type: 'free' },
      { name: 'Marseille', coords: [43.2965, 5.3698], desc: 'Grand port méditerranéen en zone libre.', type: 'free' },
      { name: 'Lille', coords: [50.6292, 3.0573], desc: 'Ville du nord en zone occupée. Administration militaire allemande.', type: 'occupied' },
      { name: 'Strasbourg', coords: [48.5734, 7.7521], desc: 'Annexée de fait au Reich allemand. Les Alsaciens sont incorporés de force dans l\'armée allemande (« malgré-nous »).', type: 'annexed' },
      { name: 'Cherbourg', coords: [49.6387, -1.6300], desc: 'Port de la Manche en zone occupée. Utilisé par la Kriegsmarine.', type: 'occupied' },
      { name: 'Brest', coords: [48.3904, -4.4861], desc: 'Base navale allemande en zone occupée.', type: 'occupied' },
      { name: 'Montoire', coords: [47.7500, 0.8670], desc: 'Rencontre Pétain-Hitler le 24 octobre 1940.', type: 'free' },
      { name: 'Toulouse', coords: [43.6047, 1.4442], desc: 'Grande ville de zone libre.', type: 'free' },
    ];

    for (const loc of locations) {
      let color, icon;
      if (loc.type === 'occupied') { color = '#dc2626'; icon = '●'; }
      else if (loc.type === 'free') { color = '#22c55e'; icon = '●'; }
      else { color = '#f97316'; icon = '◆'; }
      
      L.circleMarker(loc.coords, {
        radius: 8, color, weight: 2, fillColor: color, fillOpacity: 0.7,
      }).addTo(map)
        .bindTooltip(tooltip(`<strong style="color:${color}">${loc.name}</strong><br>${loc.desc}`), { sticky: true, className: 'map-tooltip' })
        .bindPopup(tooltip(`<strong style="color:${color}">${loc.name}</strong><br>${loc.desc}`));
    }

    // ── Legend ──
    const legendEl = document.getElementById('france-occupation-legend-content');
    if (legendEl) {
      legendEl.innerHTML = `
        <div style="display:flex;flex-direction:column;gap:0.25rem;font-size:0.8rem;">
          <span><span style="display:inline-block;width:12px;height:12px;background:#dc2626;opacity:0.3;margin-right:0.4rem;vertical-align:middle;border:1px solid #dc2626;"></span>Zone occupée</span>
          <span><span style="display:inline-block;width:12px;height:12px;background:#22c55e;opacity:0.3;margin-right:0.4rem;vertical-align:middle;border:1px solid #22c55e;"></span>Zone libre</span>
          <span><span style="display:inline-block;width:12px;height:12px;background:#f97316;opacity:0.3;margin-right:0.4rem;vertical-align:middle;border:1px solid #f97316;"></span>Zone italienne</span>
          <span><span style="display:inline-block;width:12px;height:3px;background:#fbbf24;margin-right:0.4rem;vertical-align:middle;"></span>Ligne de démarcation</span>
          <span><span style="display:inline-block;width:12px;height:12px;background:#dc2626;opacity:0.2;margin-right:0.4rem;vertical-align:middle;border:1px solid #dc2626;"></span>Alsace-Moselle annexée</span>
        </div>
      `;
    }
  })();
</script>

<style>
  :global(.map-tooltip) {
    background: #111827;
    border: 1px solid #1e293b;
    border-radius: 0.5rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
    color: #e2e8f0;
    font-size: 0.8rem;
    padding: 0.35rem 0.6rem;
    white-space: normal;
    max-width: 320px;
  }
  :global(.map-tooltip::before) { border-top-color: #1e293b; }
</style>
