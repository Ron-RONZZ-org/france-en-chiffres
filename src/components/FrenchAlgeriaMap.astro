---
// FrenchAlgeriaMap.astro — Leaflet map script for French Algeria administrative divisions (1954)
// HTML container is generated by the remark plugin via [map:french-algeria] in markdown.
---

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';
  import tippy from 'tippy.js';
  import 'tippy.js/dist/tippy.css';
  import 'tippy.js/animations/shift-away.css';

  (() => {
    const mapEl = document.getElementById('french-algeria-map');
    if (!mapEl) return;

    const map = L.map(mapEl, {
      center: [32.5, 3.5],
      zoom: 6,
      minZoom: 5,
      maxZoom: 10,
      zoomControl: true,
      attributionControl: true,
      maxBounds: [[18, -10], [40, 15]],
      maxBoundsViscosity: 1.0,
    });

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
      maxZoom: 19,
    }).addTo(map);

    // ── Départements d'Algérie française (1954) ──
    // Approximate polygon boundaries for the three main departments
    const departments = [
      {
        id: 'alger',
        nom: 'Alger',
        prefecture: 'Alger',
        pop: 2800000,
        color: '#2563eb',
        coords: [
          [36.5, 1.5], [36.5, 3.2], [37.0, 4.0],
          [36.2, 5.5], [34.5, 5.0], [34.0, 3.5],
          [34.5, 2.0], [35.5, 1.5],
        ],
      },
      {
        id: 'oran',
        nom: 'Oran',
        prefecture: 'Oran',
        pop: 1900000,
        color: '#dc2626',
        coords: [
          [35.5, 1.5], [34.5, 2.0], [34.0, 3.5],
          [32.0, 2.0], [32.0, -1.0], [33.5, -1.0],
          [35.0, -0.5], [35.5, 0.0],
        ],
      },
      {
        id: 'constantine',
        nom: 'Constantine',
        prefecture: 'Constantine',
        pop: 3200000,
        color: '#16a34a',
        coords: [
          [36.2, 5.5], [37.0, 4.0], [36.5, 3.2],
          [35.5, 4.5], [34.5, 5.0], [32.0, 5.0],
          [31.0, 9.0], [35.0, 8.5], [36.5, 7.0],
          [36.5, 5.5],
        ],
      },
    ];

    // Départements polygon + info
    departments.forEach((dept) => {
      const polygon = L.polygon(dept.coords, {
        color: dept.color,
        weight: 2,
        fillColor: dept.color,
        fillOpacity: 0.25,
      }).addTo(map);

      polygon.bindTooltip(`
        <div class="algeria-tooltip">
          <strong>Département de ${dept.nom}</strong><br>
          <span style="font-size:0.85em;opacity:0.8">Préfecture&nbsp;: ${dept.prefecture}</span><br>
          <span style="font-size:0.85em;opacity:0.8">Population~${(dept.pop / 1e6).toFixed(1)}&nbsp;M</span>
        </div>
      `, {
        sticky: true,
        direction: 'top',
        className: 'algeria-tooltip-leaflet',
      });

      polygon.on('mouseover', () => {
        polygon.setStyle({ fillOpacity: 0.45, weight: 3 });
      });
      polygon.on('mouseout', () => {
        polygon.setStyle({ fillOpacity: 0.25, weight: 2 });
      });
    });

    // ── Territoires du Sud ──
    const sud = L.polygon([
      [34.0, 3.5], [34.5, 5.0], [32.0, 5.0], [31.0, 9.0],
      [26.0, 11.0], [22.0, 9.0], [20.5, 5.0], [22.0, 2.0],
      [26.0, -1.0], [32.0, -1.0], [32.0, 2.0],
    ], {
      color: '#b7950b',
      weight: 1.5,
      fillColor: '#b7950b',
      fillOpacity: 0.12,
      dashArray: '6, 4',
    }).addTo(map);

    sud.bindTooltip(`
      <div class="algeria-tooltip">
        <strong>Territoires du Sud</strong><br>
        <span style="font-size:0.85em;opacity:0.8">Départements sahariens (Aïn Séfra, Ghardaïa, Touggourt, El Oued)</span><br>
        <span style="font-size:0.85em;opacity:0.8">Créés en 1902, administrés directement par l'armée</span>
      </div>
    `, {
      sticky: true,
      direction: 'top',
      className: 'algeria-tooltip-leaflet',
    });

    sud.on('mouseover', () => {
      sud.setStyle({ fillOpacity: 0.25, dashArray: '4, 3' });
    });
    sud.on('mouseout', () => {
      sud.setStyle({ fillOpacity: 0.12, dashArray: '6, 4' });
    });

    // ── City markers ──
    const cities = [
      { name: 'Alger', lat: 36.7538, lng: 3.0588, desc: 'Capitale de l\'Algérie française — Préfecture d\'Alger', dept: 'alger' },
      { name: 'Oran', lat: 35.6971, lng: -0.6308, desc: 'Préfecture d\'Oran — deuxième ville d\'Algérie', dept: 'oran' },
      { name: 'Constantine', lat: 36.365, lng: 6.6147, desc: 'Préfecture de Constantine — troisième ville', dept: 'constantine' },
      { name: 'Bône (Annaba)', lat: 36.9, lng: 7.7667, desc: 'Port et centre industriel du département de Constantine', dept: 'constantine' },
      { name: 'Tizi Ouzou', lat: 36.7117, lng: 4.0456, desc: 'Centre de la Kabylie, département d\'Alger', dept: 'alger' },
      { name: 'Sétif', lat: 36.1917, lng: 5.4136, desc: 'Haut-plateaux, département de Constantine', dept: 'constantine' },
      { name: 'Tlemcen', lat: 34.8867, lng: -1.3167, desc: 'Ouest algérien, département d\'Oran', dept: 'oran' },
      { name: 'Béchar', lat: 31.6167, lng: -2.2167, desc: 'Territoires du Sud — oasis saharien', dept: 'sud' },
      { name: 'Ghardaïa', lat: 32.4833, lng: 3.6667, desc: 'Territoires du Sud — vallée du M\'zab', dept: 'sud' },
    ];

    cities.forEach((city) => {
      const dept = departments.find((d) => d.id === city.dept);
      const markerColor = dept ? dept.color : '#b7950b';

      const marker = L.circleMarker([city.lat, city.lng], {
        radius: 8,
        fillColor: markerColor,
        color: '#111827',
        weight: 2,
        fillOpacity: 0.8,
      }).addTo(map);

      marker.bindTooltip(`
        <div class="algeria-tooltip">
          <strong>${city.name}</strong><br>
          <span style="font-size:0.85em;opacity:0.8">${city.desc}</span>
        </div>
      `, {
        sticky: true,
        direction: 'top',
        className: 'algeria-tooltip-leaflet',
      });

      marker.on('mouseover', () => {
        marker.setRadius(11);
      });
      marker.on('mouseout', () => {
        marker.setRadius(8);
      });
    });

    // ── Legend ──
    const legend = L.control({ position: 'bottomleft' });
    legend.onAdd = () => {
      const div = L.DomUtil.create('div', 'algeria-legend');
      div.innerHTML = `
        <p style="font-weight:700;margin:0 0 6px;font-size:13px">Algérie française — Départements (1954)</p>
        <div style="display:flex;flex-direction:column;gap:3px;font-size:11px">
          <span><span style="display:inline-block;width:12px;height:12px;background:#2563eb;border-radius:2px;margin-right:4px;vertical-align:middle"></span>Département d'Alger</span>
          <span><span style="display:inline-block;width:12px;height:12px;background:#dc2626;border-radius:2px;margin-right:4px;vertical-align:middle"></span>Département d'Oran</span>
          <span><span style="display:inline-block;width:12px;height:12px;background:#16a34a;border-radius:2px;margin-right:4px;vertical-align:middle"></span>Département de Constantine</span>
          <span><span style="display:inline-block;width:12px;height:12px;background:#b7950b;border-radius:2px;margin-right:4px;vertical-align:middle;opacity:0.5"></span>Territoires du Sud</span>
        </div>
        <p style="margin:6px 0 0;font-size:10px;opacity:0.6">Survolez les zones pour plus d'informations</p>
      `;
      return div;
    };
    legend.addTo(map);

  })();
</script>

<style>
  .algeria-map-section {
    width: 100%;
    max-width: 900px;
    margin: var(--gap-lg) auto;
    padding: 0 var(--gap-lg);
  }

  .algeria-map {
    width: 100%;
    height: 500px;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    overflow: hidden;
    background: #1e293b;
  }

  .algeria-map__noscript {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    color: var(--color-text-muted);
    font-size: 1rem;
    padding: var(--gap-lg);
    text-align: center;
  }

  :global(.algeria-legend) {
    background: rgba(15, 23, 42, 0.92);
    padding: 8px 12px;
    border-radius: 6px;
    border: 1px solid #334155;
    color: #e2e8f0;
    font-size: 12px;
    line-height: 1.5;
    backdrop-filter: blur(4px);
  }

  :global(.algeria-tooltip-leaflet) {
    background: #111827;
    border: 1px solid #334155;
    border-radius: 6px;
    color: #e2e8f0;
    font-size: 0.8rem;
    padding: 4px 8px;
  }

  :global(.leaflet-container) {
    font-family: inherit;
    background: #1e293b;
  }

  :global(.leaflet-control-zoom a) {
    background: #1e293b;
    color: #e2e8f0;
    border-color: #334155;
  }
</style>
