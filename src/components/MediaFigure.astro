---
// MediaFigure.astro — Renders a media asset (image) with attribution.
// Uses <picture> with WebP source + JPEG fallback for raster images.
// SVGs are displayed directly.

import Figure from './Figure.astro';
import type { ResolvedMedia } from '../data/media';

export interface Props {
  entry: ResolvedMedia;
  /** CSS class added to the <figure> element */
  class?: string;
  /** Display variant: "inline" (default) or "hero" (full-width) */
  variant?: 'inline' | 'hero';
}

const { entry, variant = 'inline' } = Astro.props;
const isSvg = entry.format === 'svg';
const cssClass = Astro.props.class ?? '';
const id = entry.id;
---

<Figure
  variant={variant}
  class={`media-figure ${cssClass}`.trim()}
  caption={entry.caption}
  credit={entry.credit}
  license={entry.license}
  licenseUrl={entry.licenseUrl}
  sourceId={entry.sourceId}
  dataFigureType="media"
  dataFigureId={id}
  sourceCodeMediaId={entry.sourceCode ? id : undefined}
>
  {isSvg ? (
    <img
      src={entry.src}
      alt={entry.alt}
      class="media-figure__img"
      loading="lazy"
      decoding="async"
    />
  ) : (
    <picture>
      <source srcset={`/media/${id}.webp`} type="image/webp" />
      <img
        src={`/media/${id}.jpg`}
        alt={entry.alt}
        class="media-figure__img"
        width={entry.width}
        height={entry.height}
        loading="lazy"
        decoding="async"
      />
    </picture>
  )}
</Figure>

<style>
  .media-figure__img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    background: var(--color-bg-dark);
  }
</style>
