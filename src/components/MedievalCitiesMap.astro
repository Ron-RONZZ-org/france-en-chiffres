---
// MedievalCitiesMap.astro — Leaflet map script for major medieval French cities
// HTML container is generated by the remark plugin via [map:villes-medievales] in markdown.
---

<script>
  import { initMap } from '../scripts/maps/shared-map';
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';
  import tippy from 'tippy.js';
  import 'tippy.js/dist/tippy.css';
  import 'tippy.js/animations/shift-away.css';

  (() => {
    const map = initMap('villes-medievales-map', { center: [46.8, 2.5], zoom: 6, minZoom: 5, maxZoom: 8 });
    if (!map) return;

    function tooltip(html) {
      return `<div style="font-size:0.8rem;line-height:1.4">${html}</div>`;
    }

    const villes = [
      { name: 'Paris', coords: [48.8566, 2.3522], importance: 'majeure', 
        pop: '~200 000', type: 'Capitale royale, université',
        desc: 'Plus grande ville du royaume, siège de l\'Université de Paris et du pouvoir royal. Centre intellectuel, économique et politique.' },
      { name: 'Lyon', coords: [45.7640, 4.8357], importance: 'majeure',
        pop: '~60 000', type: 'Commerce, foires',
        desc: 'Carrefour commercial entre le nord et la Méditerranée. Ses foires furent les plus importantes d\'Europe au XVe siècle.' },
      { name: 'Marseille', coords: [43.2965, 5.3698], importance: 'majeure',
        pop: '~40 000', type: 'Port méditerranéen',
        desc: 'Grand port méditerranéen. Ville quasi-indépendante, elle traitait d\'égal à égal avec les princes.' },
      { name: 'Bordeaux', coords: [44.8378, -0.5792], importance: 'majeure',
        pop: '~30 000', type: 'Port atlantique, vin',
        desc: 'Grand port atlantique sous domination anglaise puis française. Centre du commerce du vin.' },
      { name: 'Rouen', coords: [49.4431, 1.0993], importance: 'majeure',
        pop: '~40 000', type: 'Port fluvial, textile',
        desc: 'Capitale de la Normandie. Port sur la Seine, centre du commerce textile et du lin.' },
      { name: 'Toulouse', coords: [43.6047, 1.4442], importance: 'majeure',
        pop: '~30 000', type: 'Parlement, commerce',
        desc: 'Capitale du Languedoc. Siège d\'un parlement. Centre du commerce du pastel (teinture bleue).' },
      { name: 'Montpellier', coords: [43.6108, 3.8767], importance: 'regionale',
        pop: '~25 000', type: 'Université de médecine',
        desc: 'Fondée au Xe siècle, elle devint un centre médical réputé avec sa célèbre faculté de médecine.' },
      { name: 'Strasbourg', coords: [48.5734, 7.7521], importance: 'regionale',
        pop: '~25 000', type: 'Ville libre d\'Empire',
        desc: 'Ville libre du Saint-Empire. Centre du commerce rhénan. Sa cathédrale fut la plus haute du monde.' },
      { name: 'Reims', coords: [49.2583, 4.0317], importance: 'regionale',
        pop: '~15 000', type: 'Sacre des rois',
        desc: 'Ville du sacre des rois de France. Centre religieux majeur, sa cathédrale gothique est un chef-d\'œuvre.' },
      { name: 'Chartres', coords: [48.4473, 1.4875], importance: 'regionale',
        pop: '~10 000', type: 'Cathédrale, pèlerinage',
        desc: 'Célèbre pour sa cathédrale gothique et son pèlerinage. Centre intellectuel avec son école épiscopale.' },
      { name: 'Bourges', coords: [47.0833, 2.4000], importance: 'regionale',
        pop: '~12 000', type: 'Capitale du Berry',
        desc: 'Capitale du Berry. Sa cathédrale Saint-Étienne est un joyau du gothique classé à l\'UNESCO.' },
      { name: 'Amiens', coords: [49.8940, 2.2957], importance: 'regionale',
        pop: '~15 000', type: 'Cathédrale, textile',
        desc: 'Sa cathédrale gothique est la plus vaste de France. Centre textile important.' },
      { name: 'Lille', coords: [50.6292, 3.0573], importance: 'regionale',
        pop: '~15 000', type: 'Commerce drapier',
        desc: 'Ville flamande rattachée à la France. Centre de l\'industrie drapière et du commerce nordique.' },
      { name: 'Nantes', coords: [47.2184, -1.5536], importance: 'regionale',
        pop: '~20 000', type: 'Port ligérien',
        desc: 'Port sur la Loire. Centre du commerce atlantique. Son château des ducs de Bretagne symbolise son pouvoir.' },
      { name: 'Avignon', coords: [43.9493, 4.8055], importance: 'regionale',
        pop: '~25 000', type: 'Cité des papes',
        desc: 'Devenue résidence des papes de 1309 à 1376. Centre de la chrétienté occidentale au XIVe siècle.' },
      { name: 'Troyes', coords: [48.2973, 4.0744], importance: 'regionale',
        pop: '~12 000', type: 'Foires de Champagne',
        desc: 'Centre des foires de Champagne, les plus grandes foires commerciales de l\'Europe médiévale.' },
      { name: 'Provins', coords: [48.5600, 3.2990], importance: 'regionale',
        pop: '~8 000', type: 'Foires de Champagne',
        desc: 'Autre centre majeur des foires de Champagne. Sa ville haute médiévale est classée à l\'UNESCO.' },
      { name: 'Laon', coords: [49.5633, 3.6242], importance: 'regionale',
        pop: '~8 000', type: 'Commune, cathédrale',
        desc: 'L\'une des premières communes françaises (1115). Sa cathédrale gothique primitive est un modèle du genre.' },
      { name: 'Beauvais', coords: [49.4292, 2.0950], importance: 'regionale',
        pop: '~8 000', type: 'Cathédrale',
        desc: 'Sa cathédrale Saint-Pierre a la voûte gothique la plus haute du monde (48 m).' },
      { name: 'Le Mans', coords: [48.0061, 0.1996], importance: 'regionale',
        pop: '~10 000', type: 'Première commune',
        desc: 'Première charte de commune de France accordée en 1067. Sa cité médiévale est exceptionnellement bien conservée.' },
    ];

    const legendEl = document.getElementById('villes-medievales-legend-content');

    for (const v of villes) {
      const isMajor = v.importance === 'majeure';
      const color = isMajor ? '#d4a843' : '#60a5fa';
      const radius = isMajor ? 10 : 7;

      const marker = L.circleMarker(v.coords, {
        radius,
        color,
        weight: 2,
        fillColor: color,
        fillOpacity: 0.7,
      }).addTo(map);

      marker.bindTooltip(tooltip(`
        <strong style="color:${color}">${v.name}</strong><br>
        <span style="color:#94a3b8">${v.type}</span><br>
        <span>Population : ${v.pop}</span>
      `), { sticky: true, className: 'map-tooltip' });

      marker.bindPopup(tooltip(`
        <strong style="color:${color}">${v.name}</strong><br>
        <span style="color:#94a3b8">${v.type}</span><br>
        Population : ${v.pop}<br><br>
        ${v.desc}
      `));

      marker.on('mouseover', () => {
        if (legendEl) {
          legendEl.innerHTML = `
            <div class="map-shell__legend-site" style="color:${color}">${v.name}</div>
            <div class="map-shell__legend-desc">${v.type}</div>
            <div class="map-shell__legend-age">Population : ${v.pop}</div>
            <div class="map-shell__legend-desc" style="margin-top:0.3rem">${v.desc}</div>
          `;
        }
      });
      marker.on('mouseout', () => {
        if (legendEl) {
          legendEl.innerHTML = '<p class="map-shell__legend-placeholder">Survolez une ville pour voir les détails.</p>';
        }
      });
    }

    // Add a control legend
    const legend = L.control({ position: 'bottomleft' });
    legend.onAdd = function() {
      const div = L.DomUtil.create('div', 'map-legend');
      div.innerHTML = `
        <div style="background:#111827;padding:0.5rem 0.75rem;border-radius:6px;border:1px solid #334155;font-size:0.75rem;line-height:1.8">
          <div><span style="display:inline-block;width:12px;height:12px;background:#d4a843;border-radius:50%;margin-right:4px;"></span> Ville majeure</div>
          <div><span style="display:inline-block;width:12px;height:12px;background:#60a5fa;border-radius:50%;margin-right:4px;"></span> Ville régionale</div>
        </div>
      `;
      return div;
    };
    legend.addTo(map);
  })();
</script>

<style>
  :global(.map-tooltip) {
    background: #111827;
    border: 1px solid #1e293b;
    border-radius: 0.5rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
    color: #e2e8f0;
    font-size: 0.8rem;
    padding: 0.35rem 0.6rem;
    white-space: normal;
    max-width: 280px;
  }
  :global(.map-tooltip::before) {
    border-top-color: #1e293b;
  }
  :global(.map-legend) {
    color: #cbd5e1;
    line-height: 1.6;
  }
</style>
