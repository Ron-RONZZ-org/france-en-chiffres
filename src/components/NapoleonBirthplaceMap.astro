---
// NapoleonBirthplaceMap.astro — Leaflet map script for Napoleon's birthplace and early career locations
// HTML container is generated by the remark plugin via [map:napoleon-naissance] in markdown.
---

<script>
  import { initMap, onViewTransition } from '../scripts/maps/shared-map';
  import tippy from 'tippy.js';
  import 'tippy.js/dist/tippy.css';
  import 'tippy.js/animations/shift-away.css';

  (() => {
    const map = initMap('napoleon-naissance-map', {
      center: [42.0, 9.0],
      zoom: 7,
      minZoom: 5,
      maxZoom: 10,
    });
    if (!map) return;

    const sites = [
      {
        id: 'ajaccio',
        name: 'Ajaccio',
        coords: [41.9267, 8.7369],
        date: '15 août 1769',
        desc: 'Lieu de naissance de Napoleone Buonaparte, dans une maison de la rue Malerba (aujourd\'hui rue Bonaparte). La Corse avait été cédée à la France par Gênes l\'année précédente.',
        type: 'naissance',
      },
      {
        id: 'brienne',
        name: 'Brienne-le-Château',
        coords: [48.3917, 4.5258],
        date: '1779–1784',
        desc: 'École militaire de Brienne. Napoléon y entre à neuf ans, boursier du roi, sur recommandation du député de la noblesse corse.',
        type: 'formation',
      },
      {
        id: 'ecole-militaire',
        name: 'École militaire de Paris',
        coords: [48.8521, 2.3051],
        date: '1784–1785',
        desc: 'École militaire de Paris (actuelle École militaire, VIIe arr.). Il en sort sous-lieutenant d\'artillerie en 1785, à seize ans.',
        type: 'formation',
      },
      {
        id: 'toulon',
        name: 'Toulon',
        coords: [43.1242, 5.9280],
        date: '1793',
        desc: 'Siège de Toulon. Ses batteries d\'artillerie chassent les Anglais du port. Promu général de brigade à vingt-quatre ans.',
        type: 'militaire',
      },
      {
        id: 'bastia',
        name: 'Bastia',
        coords: [42.6973, 9.4503],
        date: '1769',
        desc: 'Port principal de la Corse sous administration génoise puis française. La famille Buonaparte y avait des liens.',
        type: 'region',
      },
    ];

    const legendContent = document.getElementById('napoleon-naissance-legend-content');

    function updateLegend(site) {
      if (!legendContent) return;
      legendContent.innerHTML = `
        <p class="map-shell__legend-site"><strong>${site.name}</strong></p>
        <p class="map-shell__legend-lieu" style="color:#d4a843">${site.date}</p>
        <p class="map-shell__legend-desc">${site.desc}</p>
      `;
    }

    function clearLegend() {
      if (!legendContent) return;
      legendContent.innerHTML = '<p class="map-shell__legend-placeholder">Survolez un marqueur pour plus d\'informations.</p>';
    }

    sites.forEach((site) => {
      const colors = { naissance: '#d4a843', formation: '#3b82f6', militaire: '#ef4444', region: '#6b7280' };
      const color = colors[site.type] || '#6b7280';

      const marker = L.circleMarker(site.coords, {
        radius: site.type === 'naissance' ? 14 : 10,
        color: color,
        weight: 2,
        fillColor: color,
        fillOpacity: 0.7,
      }).addTo(map);

      marker.bindTooltip(`<div style="font-size:0.8rem;line-height:1.4"><strong>${site.name}</strong><br><span style="color:${color}">${site.date}</span><br>${site.desc}</div>`);

      marker.on('mouseover', () => updateLegend(site));
      marker.on('mouseout', () => clearLegend());
      
      marker.on('click', () => {
        map.setView(site.coords, 9, { animate: true });
      });
    });

    // Fit bounds
    const bounds = L.latLngBounds(sites.map((s) => s.coords));
    map.fitBounds(bounds, { padding: [50, 50], maxZoom: 7 });

    onViewTransition(map);
  })();
</script>
