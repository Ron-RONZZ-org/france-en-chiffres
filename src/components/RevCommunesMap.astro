---
// RevCommunesMap.astro — Leaflet map script for Revolutionary communes (summer 1789)
// HTML container is generated by the remark plugin via [map:rev-communes] in markdown.
---

<script>
  import { initMap } from '../scripts/maps/shared-map';
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';

  (() => {
    const map = initMap('rev-communes-map', { center: [46.6, 2.5], zoom: 6 });
    if (!map) return;

    const communes = [
      { name: 'Paris', coords: [48.8566, 2.3522], date: '14 juillet 1789', desc: 'Commune insurrectionnelle dès le 14 juillet. Le roi y est ramené en octobre.' },
      { name: 'Lyon', coords: [45.7640, 4.8357], date: 'Juillet 1789', desc: 'Deuxième ville du royaume. Commune révolutionnaire formée dès la mi-juillet.' },
      { name: 'Marseille', coords: [43.2965, 5.3698], date: 'Juillet 1789', desc: 'Grand port méditerranéen. La commune révolutionnaire prend le pouvoir en juillet.' },
      { name: 'Bordeaux', coords: [44.8378, -0.5792], date: 'Juillet 1789', desc: 'Grand port atlantique. Ralliée à la Révolution dès la nouvelle de la prise de la Bastille.' },
      { name: 'Nantes', coords: [47.2184, -1.5536], date: 'Juillet 1789', desc: 'Port négrier. Commune révolutionnaire formée fin juillet.' },
      { name: 'Rouen', coords: [49.4431, 1.0993], date: 'Août 1789', desc: 'Capitale normande. Ancienne municipalité remplacée par une commune élue.' },
      { name: 'Lille', coords: [50.6292, 3.0573], date: 'Août 1789', desc: 'Grande ville du nord. Commune révolutionnaire établie en août.' },
      { name: 'Strasbourg', coords: [48.5734, 7.7521], date: 'Août 1789', desc: 'Ville libre d\'Empire. Ralliée à la Révolution en août.' },
      { name: 'Toulouse', coords: [43.6047, 1.4442], date: 'Juillet 1789', desc: 'Capitale du Languedoc. Commune révolutionnaire établie en juillet.' },
      { name: 'Grenoble', coords: [45.1885, 5.7245], date: 'Été 1789', desc: 'Journée des Tuiles (7 juin 1788). Les trois ordres s\'y réunissent avant les États généraux.' },
    ];

    for (const c of communes) {
      const marker = L.circleMarker(c.coords, {
        radius: 10, color: '#d4a843', weight: 2, fillColor: '#d4a843', fillOpacity: 0.7,
      }).addTo(map);
      marker.bindTooltip(`<div style="font-size:0.8rem;line-height:1.4"><strong>${c.name}</strong><br><span style="color:#d4a843">${c.date}</span><br>${c.desc}</div>`, {
        sticky: true, className: 'rev-map-tooltip',
      });
      marker.bindPopup(`<div style="font-size:0.8rem;line-height:1.4"><strong>${c.name}</strong><br><span style="color:#d4a843">${c.date}</span><br>${c.desc}</div>`);
    }
  })();
</script>

<style>
  :global(.rev-map-tooltip) {
    background: #111827;
    border: 1px solid #1e293b;
    border-radius: 0.5rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
    color: #e2e8f0;
    font-size: 0.8rem;
    padding: 0.35rem 0.6rem;
    white-space: normal;
    max-width: 280px;
  }
  :global(.rev-map-tooltip::before) {
    border-top-color: #1e293b;
  }
</style>
