---
// RevParisMap.astro — Leaflet map script for Revolutionary Paris
// HTML container is generated by the remark plugin via [map:rev-paris] in markdown.
---

<script>
  import { initMap } from '../scripts/maps/shared-map';
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';

  (() => {
    const map = initMap('rev-paris-map', { center: [48.855, 2.347], zoom: 13 });
    if (!map) return;

    const populaires = [
      { name: 'Faubourg Saint-Antoine', coords: [48.8500, 2.3800], desc: 'Cœur des sans-culottes. Point de départ du 14 juillet 1789.' },
      { name: 'Rue Mouffetard', coords: [48.8400, 2.3500], desc: 'Artère populaire de la Montagne Sainte-Geneviève. Marché permanent.' },
      { name: 'Les Halles', coords: [48.8624, 2.3457], desc: 'Centre de ravitaillement. Les femmes des Halles mènent la marche sur Versailles en octobre 1789.' },
      { name: 'Place de la Bastille', coords: [48.8531, 2.3692], desc: 'Symbole de l\'arbitraire royal détruit le 14 juillet 1789.' },
      { name: 'Montagne Sainte-Geneviève', coords: [48.8467, 2.3467], desc: 'Quartier latin populaire. Sections sans-culottes actives.' },
      { name: 'Place de Grève', coords: [48.8566, 2.3488], desc: 'Place d\'exécution sous la Terreur. Siège de la Commune de Paris.' },
    ];

    const pouvoir = [
      { name: 'Palais des Tuileries', coords: [48.8628, 2.3292], desc: 'Résidence forcée du roi après octobre 1789. Envahi le 10 août 1792.' },
      { name: 'Place de la Révolution', coords: [48.8656, 2.3211], desc: 'Louis XVI et Marie-Antoinette y sont guillotinés (actuelle place de la Concorde).' },
      { name: 'Le Marais', coords: [48.8580, 2.3620], desc: 'Quartier aristocratique. Hôtels particuliers de la noblesse.' },
    ];

    for (const p of populaires) {
      L.circleMarker(p.coords, {
        radius: 10, color: '#3b82f6', weight: 2, fillColor: '#3b82f6', fillOpacity: 0.5,
      }).addTo(map)
        .bindTooltip(`<div style="font-size:0.8rem;line-height:1.4"><strong style="color:#60a5fa">${p.name}</strong><br>${p.desc}</div>`, { sticky: true, className: 'rev-map-tooltip' })
        .bindPopup(`<div style="font-size:0.8rem;line-height:1.4"><strong style="color:#60a5fa">${p.name}</strong><br>${p.desc}</div>`);
    }

    for (const p of pouvoir) {
      L.circleMarker(p.coords, {
        radius: 10, color: '#ef4444', weight: 2, fillColor: '#ef4444', fillOpacity: 0.5,
      }).addTo(map)
        .bindTooltip(`<div style="font-size:0.8rem;line-height:1.4"><strong style="color:#f87171">${p.name}</strong><br>${p.desc}</div>`, { sticky: true, className: 'rev-map-tooltip' })
        .bindPopup(`<div style="font-size:0.8rem;line-height:1.4"><strong style="color:#f87171">${p.name}</strong><br>${p.desc}</div>`);
    }
  })();
</script>

<style>
  :global(.rev-map-tooltip) {
    background: #111827;
    border: 1px solid #1e293b;
    border-radius: 0.5rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
    color: #e2e8f0;
    font-size: 0.8rem;
    padding: 0.35rem 0.6rem;
    white-space: normal;
    max-width: 280px;
  }
  :global(.rev-map-tooltip::before) {
    border-top-color: #1e293b;
  }
</style>
