---
// RevolutionMaps.astro — 3 Leaflet maps for the French Revolution event
// Map 1: Revolutionary communes (summer 1789)
// Map 2: Flight to Varennes (June 1791)
// Map 3: Revolutionary Paris (popular quarters vs power centers)
import MapShell from './MapShell.astro';
---

<MapShell id="rev-communes" label="Carte des communes révolutionnaires en 1789" title="Communes révolutionnaires (été 1789)" hint="Les villes où des municipalités élues remplacèrent les autorités royales dès juillet-août 1789. Cliquez sur un marqueur pour plus de détails." />

<MapShell id="rev-varennes" label="Carte de la fuite à Varennes" title="Fuite de Louis XVI à Varennes (21-22 juin 1791)" hint="Itinéraire de Paris vers Montmédy. Cliquez sur les étapes pour plus de détails." />

<MapShell id="rev-paris" label="Carte de Paris révolutionnaire" title="Paris révolutionnaire — quartiers populaires et lieux de pouvoir" hint="En bleu : quartiers populaires des sans-culottes. En rouge : lieux du pouvoir royal puis républicain. Cliquez pour plus de détails." />

<script>
  import { initMap } from '../scripts/maps/shared-map';
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';
  import tippy from 'tippy.js';
  import 'tippy.js/dist/tippy.css';
  import 'tippy.js/animations/shift-away.css';

  (() => {
    const motionOK = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;

    function tooltip(html) {
      return `<div style="font-size:0.8rem;line-height:1.4">${html}</div>`;
    }

    // ─── 1. Communes révolutionnaires ────────────────────────────────
    const map1 = initMap('rev-communes-map', { center: [46.6, 2.5], zoom: 6 });
    if (map1) {
      const communes = [
        { name: 'Paris', coords: [48.8566, 2.3522], date: '14 juillet 1789', desc: 'Commune insurrectionnelle dès le 14 juillet. Le roi y est ramené en octobre.' },
        { name: 'Lyon', coords: [45.7640, 4.8357], date: 'Juillet 1789', desc: 'Deuxième ville du royaume. Commune révolutionnaire formée dès la mi-juillet.' },
        { name: 'Marseille', coords: [43.2965, 5.3698], date: 'Juillet 1789', desc: 'Grand port méditerranéen. La commune révolutionnaire prend le pouvoir en juillet.' },
        { name: 'Bordeaux', coords: [44.8378, -0.5792], date: 'Juillet 1789', desc: 'Grand port atlantique. Ralliée à la Révolution dès la nouvelle de la prise de la Bastille.' },
        { name: 'Nantes', coords: [47.2184, -1.5536], date: 'Juillet 1789', desc: 'Port négrier. Commune révolutionnaire formée fin juillet.' },
        { name: 'Rouen', coords: [49.4431, 1.0993], date: 'Août 1789', desc: 'Capitale normande. Ancienne municipalité remplacée par une commune élue.' },
        { name: 'Lille', coords: [50.6292, 3.0573], date: 'Août 1789', desc: 'Grande ville du nord. Commune révolutionnaire établie en août.' },
        { name: 'Strasbourg', coords: [48.5734, 7.7521], date: 'Août 1789', desc: 'Ville libre d\'Empire. Ralliée à la Révolution en août.' },
        { name: 'Toulouse', coords: [43.6047, 1.4442], date: 'Juillet 1789', desc: 'Capitale du Languedoc. Commune révolutionnaire établie en juillet.' },
        { name: 'Grenoble', coords: [45.1885, 5.7245], date: 'Été 1789', desc: 'Journée des Tuiles (7 juin 1788). Les trois ordres s\'y réunissent avant les États généraux.' },
      ];
      const legendEl = document.getElementById('rev-communes-legend-content');
      for (const c of communes) {
        const marker = L.circleMarker(c.coords, {
          radius: 10, color: '#d4a843', weight: 2, fillColor: '#d4a843', fillOpacity: 0.7,
        }).addTo(map1);
        marker.bindTooltip(tooltip(`<strong>${c.name}</strong><br><span style="color:#d4a843">${c.date}</span><br>${c.desc}`), {
          sticky: true, className: 'rev-map-tooltip',
        });
        marker.bindPopup(tooltip(`<strong>${c.name}</strong><br><span style="color:#d4a843">${c.date}</span><br>${c.desc}`));
      }
    }

    // ─── 2. Fuite à Varennes ────────────────────────────────────────
    const map2 = initMap('rev-varennes-map', { center: [49.05, 4.0], zoom: 9 });
    if (map2) {
      const stops = [
        { name: 'Paris (Tuileries)', coords: [48.8628, 2.3292], desc: 'Départ de la famille royale déguisée, le 20 juin 1791 à 23 h.' },
        { name: 'Bondy', coords: [48.9018, 2.5395], desc: 'Premier relais. Changement de chevaux sous une fausse identité.' },
        { name: 'Meaux', coords: [48.9594, 2.8867], desc: 'Relais de poste. La famille traverse la ville sans être reconnue.' },
        { name: 'Châlons-sur-Marne', coords: [48.9547, 4.3625], desc: 'Arrêt vers midi le 21 juin. Le roi est reconnu par un cavalier.' },
        { name: 'Sainte-Menehould', coords: [49.0897, 4.8978], desc: 'Le maître de poste Drouet reconnaît le roi et galope prévenir Varennes.' },
        { name: 'Varennes-en-Argonne', coords: [49.2268, 5.0365], desc: 'Arrêtés à 23 h le 21 juin. Le roi est stoppé à quelques kilomètres de la frontière.' },
        { name: 'Montmédy (objectif)', coords: [49.5194, 5.3643], desc: 'Forteresse royaliste où le général Bouillé attendait le roi. Il n\'arrivera jamais.' },
      ];
      const routeCoords = stops.map(s => s.coords);
      L.polyline(routeCoords, {
        color: '#ef4444', weight: 3, opacity: 0.7, dashArray: motionOK ? '8, 8' : null,
      }).addTo(map2).bindTooltip(tooltip('<strong>Itinéraire de la fuite</strong><br>Paris → Varennes, environ 250 km'), { className: 'rev-map-tooltip' });
      for (const s of stops) {
        const isArrest = s.name.includes('Varennes');
        const isTarget = s.name === 'Montmédy (objectif)';
        L.circleMarker(s.coords, {
          radius: isArrest ? 10 : (isTarget ? 7 : 6),
          color: isArrest ? '#ef4444' : (isTarget ? '#94a3b8' : '#d4a843'),
          weight: 2, fillColor: isArrest ? '#ef4444' : (isTarget ? '#94a3b8' : '#d4a843'),
          fillOpacity: isArrest ? 0.9 : 0.7,
        }).addTo(map2)
          .bindTooltip(tooltip(`<strong>${s.name}</strong><br>${s.desc}`), { sticky: true, className: 'rev-map-tooltip' })
          .bindPopup(tooltip(`<strong>${s.name}</strong><br>${s.desc}`));
      }
    }

    // ─── 3. Paris révolutionnaire ────────────────────────────────────
    const map3 = initMap('rev-paris-map', { center: [48.855, 2.347], zoom: 13 });
    if (map3) {
      const populaires = [
        { name: 'Faubourg Saint-Antoine', coords: [48.8500, 2.3800], desc: 'Cœur des sans-culottes. Point de départ du 14 juillet 1789.' },
        { name: 'Rue Mouffetard', coords: [48.8400, 2.3500], desc: 'Artère populaire de la Montagne Sainte-Geneviève. Marché permanent.' },
        { name: 'Les Halles', coords: [48.8624, 2.3457], desc: 'Centre de ravitaillement. Les femmes des Halles mènent la marche sur Versailles en octobre 1789.' },
        { name: 'Place de la Bastille', coords: [48.8531, 2.3692], desc: 'Symbole de l\'arbitraire royal détruit le 14 juillet 1789.' },
        { name: 'Montagne Sainte-Geneviève', coords: [48.8467, 2.3467], desc: 'Quartier latin populaire. Sections sans-culottes actives.' },
        { name: 'Place de Grève', coords: [48.8566, 2.3488], desc: 'Place d\'exécution sous la Terreur. Siège de la Commune de Paris.' },
      ];
      const pouvoir = [
        { name: 'Palais des Tuileries', coords: [48.8628, 2.3292], desc: 'Résidence forcée du roi après octobre 1789. Envahi le 10 août 1792.' },
        { name: 'Place de la Révolution', coords: [48.8656, 2.3211], desc: 'Louis XVI et Marie-Antoinette y sont guillotinés (actuelle place de la Concorde).' },
        { name: 'Le Marais', coords: [48.8580, 2.3620], desc: 'Quartier aristocratique. Hôtels particuliers de la noblesse.' },
      ];
      for (const p of populaires) {
        L.circleMarker(p.coords, {
          radius: 10, color: '#3b82f6', weight: 2, fillColor: '#3b82f6', fillOpacity: 0.5,
        }).addTo(map3)
          .bindTooltip(tooltip(`<strong style="color:#60a5fa">${p.name}</strong><br>${p.desc}`), { sticky: true, className: 'rev-map-tooltip' })
          .bindPopup(tooltip(`<strong style="color:#60a5fa">${p.name}</strong><br>${p.desc}`));
      }
      for (const p of pouvoir) {
        L.circleMarker(p.coords, {
          radius: 10, color: '#ef4444', weight: 2, fillColor: '#ef4444', fillOpacity: 0.5,
        }).addTo(map3)
          .bindTooltip(tooltip(`<strong style="color:#f87171">${p.name}</strong><br>${p.desc}`), { sticky: true, className: 'rev-map-tooltip' })
          .bindPopup(tooltip(`<strong style="color:#f87171">${p.name}</strong><br>${p.desc}`));
      }
    }
  })();
</script>

<style>
  :global(.rev-map-tooltip) {
    background: #111827;
    border: 1px solid #1e293b;
    border-radius: 0.5rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
    color: #e2e8f0;
    font-size: 0.8rem;
    padding: 0.35rem 0.6rem;
    white-space: normal;
    max-width: 280px;
  }

  :global(.rev-map-tooltip::before) {
    border-top-color: #1e293b;
  }
</style>
