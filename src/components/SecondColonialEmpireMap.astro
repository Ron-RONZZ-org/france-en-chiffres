---
// SecondColonialEmpireMap.astro — Leaflet map of the 2nd French colonial empire (1914)
// Shows territories of the 2nd empire in solid green,
// and remaining 1st empire territories in hatched blue
---

<section class="colonial-map-section">
  <div id="second-colonial-empire-map" class="colonial-map" role="application" aria-label="Carte du second empire colonial français (1914)">
    <noscript>
      <div class="colonial-map__noscript">
        <p>La carte interactive nécessite JavaScript.</p>
      </div>
    </noscript>
  </div>
</section>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';
  import tippy from 'tippy.js';
  import 'tippy.js/dist/tippy.css';
  import 'tippy.js/animations/shift-away.css';

  (() => {
    const mapEl = document.getElementById('second-colonial-empire-map');
    if (!mapEl) return;

    // 2nd French colonial empire territories (approx modern countries, ca. 1914)
    const secondEmpire = {
      label: 'Second empire colonial français (1914)',
      color: '#16a34a',
      countries: [
        'DZA', 'TUN', 'MAR', 'MRT', 'SEN', 'MLI', 'GIN', 'CIV', 'BFA',
        'BEN', 'NER', 'TCD', 'CAF', 'COG', 'GAB', 'MDG', 'COM', 'DJI',
        'VNM', 'LAO', 'KHM', 'PYF', 'NCL', 'VUT',
      ],
    };

    // Territories kept from 1st empire
    const firstEmpireKept = {
      label: 'Vestiges du premier empire (avant 1815)',
      color: '#2563eb',
      countries: ['GLP', 'MTQ', 'GUF', 'REU', 'SPM', 'MYT'],
    };

    const map = L.map(mapEl, {
      center: [20, 10],
      zoom: 2,
      minZoom: 2,
      maxZoom: 5,
      zoomControl: true,
      attributionControl: true,
      maxBounds: [[-90, -180], [90, 180]],
      maxBoundsViscosity: 1.0,
    });

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OSM</a>',
      maxZoom: 19,
    }).addTo(map);

    let worldData = null;

    async function loadData() {
      try {
        const resp = await fetch('/data/geo/world-countries.json');
        if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
        worldData = await resp.json();

        L.geoJSON(worldData, {
          style: (feature) => {
            const iso = feature.properties.iso_a3;
            if (secondEmpire.countries.includes(iso)) {
              return {
                fillColor: secondEmpire.color,
                fillOpacity: 0.55,
                color: '#166534',
                weight: 0.8,
              };
            }
            if (firstEmpireKept.countries.includes(iso)) {
              return {
                fillColor: firstEmpireKept.color,
                fillOpacity: 0.55,
                color: '#1e40af',
                weight: 0.8,
              };
            }
            return {
              fillColor: '#1e293b',
              fillOpacity: 0.1,
              color: '#475569',
              weight: 0.5,
            };
          },
          onEachFeature: (feature, layer) => {
            const props = feature.properties;
            const iso = props.iso_a3;
            const name = props.name_fr || props.name_en || iso;

            let groupInfo = '';
            if (secondEmpire.countries.includes(iso)) groupInfo = secondEmpire.label;
            else if (firstEmpireKept.countries.includes(iso)) groupInfo = firstEmpireKept.label;

            const tip = groupInfo
              ? `<div class="colonial-tooltip"><strong>${name}</strong><br><span style="font-size:0.85em;opacity:0.8">${groupInfo}</span></div>`
              : `<div class="colonial-tooltip">${name}</div>`;

            layer.bindTooltip(tip, {
              sticky: true,
              direction: 'top',
              className: 'colonial-tooltip-leaflet',
            });

            if (groupInfo) {
              layer.on('mouseover', () => {
                layer.setStyle({ fillOpacity: 0.8, weight: 1.5 });
              });
              layer.on('mouseout', () => {
                const isGreen = secondEmpire.countries.includes(iso);
                layer.setStyle({ fillOpacity: 0.55, weight: 0.8 });
              });
            }
          },
        }).addTo(map);

        // Legend
        const legend = L.control({ position: 'bottomleft' });
        legend.onAdd = () => {
          const div = L.DomUtil.create('div', 'colonial-legend');
          div.innerHTML = `
            <p style="font-weight:700;margin:0 0 4px;font-size:13px">Empire colonial français (1914)</p>
            <div style="display:flex;flex-direction:column;gap:2px;font-size:11px">
              <span><span style="display:inline-block;width:12px;height:12px;background:#16a34a;border-radius:2px;margin-right:4px;vertical-align:middle"></span>${secondEmpire.label}</span>
              <span><span style="display:inline-block;width:12px;height:12px;background:#2563eb;border-radius:2px;margin-right:4px;vertical-align:middle"></span>${firstEmpireKept.label}</span>
            </div>
          `;
          return div;
        };
        legend.addTo(map);

      } catch (err) {
        console.error('Failed to load world data:', err);
      }
    }

    loadData();
  })();
</script>

<style>
  .colonial-map-section {
    width: 100%;
    max-width: 900px;
    margin: var(--gap-lg) auto;
    padding: 0 var(--gap-lg);
  }

  .colonial-map {
    width: 100%;
    height: 450px;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    overflow: hidden;
    background: #1e293b;
  }

  .colonial-map__noscript {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    color: var(--color-text-muted);
    font-size: 1rem;
    padding: var(--gap-lg);
    text-align: center;
  }

  :global(.colonial-legend) {
    background: rgba(15, 23, 42, 0.92);
    padding: 8px 12px;
    border-radius: 6px;
    border: 1px solid #334155;
    color: #e2e8f0;
    font-size: 12px;
    line-height: 1.5;
    backdrop-filter: blur(4px);
  }

  :global(.colonial-tooltip-leaflet) {
    background: #111827;
    border: 1px solid #334155;
    border-radius: 6px;
    color: #e2e8f0;
    font-size: 0.8rem;
    padding: 4px 8px;
  }

  :global(.leaflet-container) {
    font-family: inherit;
    background: #1e293b;
  }

  :global(.leaflet-control-zoom a) {
    background: #1e293b;
    color: #e2e8f0;
    border-color: #334155;
  }
</style>
