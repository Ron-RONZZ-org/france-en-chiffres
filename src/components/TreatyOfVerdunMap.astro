---
// TreatyOfVerdunMap.astro — Leaflet map script for the division of the Carolingian Empire
// after the Treaty of Verdun (843).
// HTML container is generated by the remark plugin via [map:traite-verdun] in markdown.
---

<script>
  import { initMap } from '../scripts/maps/shared-map';
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';
  import tippy from 'tippy.js';
  import 'tippy.js/dist/tippy.css';
  import 'tippy.js/animations/shift-away.css';

  (() => {
    const map = initMap('traite-verdun-map', { center: [47.5, 6], zoom: 6, minZoom: 4, maxZoom: 8 });
    if (!map) return;

    function tooltip(html) {
      return `<div style="font-size:0.8rem;line-height:1.4">${html}</div>`;
    }

    // Approximate polygons for the three kingdoms after Treaty of Verdun (843)
    // These are simplified approximations for illustrative purposes
    const kingdoms = [
      {
        name: 'Francie occidentale',
        nameFr: 'Francie occidentale (France)',
        king: 'Charles le Chauve',
        capital: 'Paris',
        color: '#1a5276',
        fillOpacity: 0.25,
        weight: 2,
        desc: 'Devenue le royaume de France. Territoire correspondant approximativement à la France actuelle à l\'ouest de l\'Escaut, la Meuse, la Saône et le Rhône.',
        coords: [
          [51.5, 2.0], [51.0, 4.0], [49.5, 5.0], [48.0, 6.0],
          [47.0, 5.5], [46.0, 4.5], [45.0, 4.0], [44.0, 3.5],
          [43.0, 2.5], [42.5, 3.0], [42.5, -1.5], [43.5, -1.5],
          [44.5, -1.5], [45.5, -1.0], [46.5, -1.5], [47.5, -2.0],
          [48.0, -3.0], [48.5, -3.0], [48.8, -2.0], [49.0, -1.0],
          [49.5, 0.0], [50.0, 1.0], [50.5, 1.5], [51.0, 2.0],
          [51.5, 2.0],
        ],
      },
      {
        name: 'Francie médiane',
        nameFr: 'Francie médiane (Lotharingie)',
        king: 'Lothaire Ier',
        capital: 'Aix-la-Chapelle',
        color: '#922b21',
        fillOpacity: 0.25,
        weight: 2,
        desc: 'Attribuée à Lothaire Ier, empereur. S\'étendait de la mer du Nord à l\'Italie, incluant les Flandres, la Lorraine, la Bourgogne, la Provence et l\'Italie du Nord.',
        coords: [
          [52.0, 4.0], [51.5, 6.0], [50.0, 7.0], [49.0, 7.0],
          [48.0, 8.0], [47.0, 8.0], [46.5, 8.0], [46.0, 7.5],
          [45.5, 7.0], [45.0, 7.5], [44.5, 7.0], [44.0, 7.5],
          [43.5, 8.0], [43.0, 7.5], [42.5, 8.5], [42.0, 8.0],
          [42.0, 6.0], [43.0, 5.5], [44.0, 5.0], [45.0, 5.0],
          [46.0, 5.0], [47.0, 6.0], [48.0, 6.0], [49.5, 5.0],
          [51.0, 4.0], [52.0, 4.0],
        ],
      },
      {
        name: 'Francie orientale',
        nameFr: 'Francie orientale (Germanie)',
        king: 'Louis le Germanique',
        capital: 'Francfort',
        color: '#1e8449',
        fillOpacity: 0.25,
        weight: 2,
        desc: 'Devenue le royaume de Germanie, ancêtre du Saint-Empire romain germanique. Territoire à l\'est du Rhin, correspondant à l\'Allemagne actuelle.',
        coords: [
          [52.0, 7.0], [51.5, 9.0], [50.5, 10.0], [49.5, 10.0],
          [48.5, 9.5], [48.0, 9.0], [47.5, 8.5], [47.0, 8.0],
          [46.5, 8.0], [46.0, 8.5], [45.5, 9.0], [45.0, 8.5],
          [44.5, 8.0], [44.0, 8.5], [43.5, 9.0], [43.0, 10.0],
          [43.0, 11.0], [43.5, 12.0], [44.0, 12.5], [45.0, 13.0],
          [46.0, 13.5], [47.0, 13.0], [48.0, 12.5], [48.5, 12.0],
          [49.0, 12.0], [49.5, 11.5], [50.0, 11.0], [50.5, 10.0],
          [51.0, 9.5], [51.5, 9.0], [52.0, 8.0], [52.0, 7.0],
        ],
      },
    ];

    const legendEl = document.getElementById('traite-verdun-legend-content');

    for (const k of kingdoms) {
      const polygon = L.polygon(k.coords, {
        color: k.color,
        weight: k.weight,
        opacity: 0.8,
        fillColor: k.color,
        fillOpacity: k.fillOpacity,
      }).addTo(map);

      polygon.bindTooltip(tooltip(`
        <strong style="color:${k.color}">${k.nameFr}</strong><br>
        <em>Roi : ${k.king}</em><br>
        ${k.desc}
      `), { sticky: true, className: 'map-tooltip' });

      polygon.on('mouseover', () => {
        polygon.setStyle({ fillOpacity: 0.4, weight: 3 });
        if (legendEl) {
          legendEl.innerHTML = `
            <div class="map-shell__legend-site" style="color:${k.color}">${k.nameFr}</div>
            <div class="map-shell__legend-desc">Roi : ${k.king}<br>Capitale : ${k.capital}</div>
            <div class="map-shell__legend-desc" style="margin-top:0.3rem">${k.desc}</div>
          `;
        }
      });
      polygon.on('mouseout', () => {
        polygon.setStyle({ fillOpacity: 0.25, weight: 2 });
        if (legendEl) {
          legendEl.innerHTML = '<p class="map-shell__legend-placeholder">Survolez un royaume pour voir les détails.</p>';
        }
      });
    }

    // Add markers for capitals
    L.circleMarker([48.8566, 2.3522], {
      radius: 6, color: '#1a5276', weight: 2, fillColor: '#1a5276', fillOpacity: 0.8,
    }).addTo(map).bindTooltip(tooltip('<strong>Paris</strong><br>Francie occidentale'), { className: 'map-tooltip' });

    L.circleMarker([50.7753, 6.0833], {
      radius: 6, color: '#922b21', weight: 2, fillColor: '#922b21', fillOpacity: 0.8,
    }).addTo(map).bindTooltip(tooltip('<strong>Aix-la-Chapelle</strong><br>Francie médiane'), { className: 'map-tooltip' });

    L.circleMarker([50.1106, 8.6821], {
      radius: 6, color: '#1e8449', weight: 2, fillColor: '#1e8449', fillOpacity: 0.8,
    }).addTo(map).bindTooltip(tooltip('<strong>Francfort</strong><br>Francie orientale'), { className: 'map-tooltip' });

    // Add a legend
    const legend = L.control({ position: 'bottomleft' });
    legend.onAdd = function() {
      const div = L.DomUtil.create('div', 'map-legend');
      div.innerHTML = `
        <div style="background:#111827;padding:0.5rem 0.75rem;border-radius:6px;border:1px solid #334155;font-size:0.75rem">
          <div><span style="display:inline-block;width:12px;height:12px;background:#1a5276;border-radius:2px;margin-right:4px;"></span> Francie occidentale</div>
          <div><span style="display:inline-block;width:12px;height:12px;background:#922b21;border-radius:2px;margin-right:4px;"></span> Francie médiane</div>
          <div><span style="display:inline-block;width:12px;height:12px;background:#1e8449;border-radius:2px;margin-right:4px;"></span> Francie orientale</div>
        </div>
      `;
      return div;
    };
    legend.addTo(map);
  })();
</script>

<style>
  :global(.map-tooltip) {
    background: #111827;
    border: 1px solid #1e293b;
    border-radius: 0.5rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
    color: #e2e8f0;
    font-size: 0.8rem;
    padding: 0.35rem 0.6rem;
    white-space: normal;
    max-width: 280px;
  }
  :global(.map-tooltip::before) {
    border-top-color: #1e293b;
  }
  :global(.map-legend) {
    color: #cbd5e1;
    line-height: 1.6;
  }
</style>
