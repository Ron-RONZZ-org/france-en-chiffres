---
// WWISchlieffenPlanMap.astro — Leaflet map script for Schlieffen Plan and Battle of the Marne (1914)
// HTML container is generated by the remark plugin via [map:wwi-schlieffen] in markdown.
---

<script>
  import { initMap } from '../scripts/maps/shared-map';
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';
  import 'tippy.js/dist/tippy.css';
  import 'tippy.js/animations/shift-away.css';

  (() => {
    function tooltip(html) {
      return `<div style="font-size:0.8rem;line-height:1.4">${html}</div>`;
    }

    const map = initMap('wwi-schlieffen-map', { center: [49.2, 3.5], zoom: 7 });
    if (!map) return;

    // ── German invasion routes (Schlieffen Plan) ──
    const germanRoutes = [
      { name: '1<sup>re</sup> armée (von Kluck)', coords: [
        [50.85, 4.35], [50.25, 4.45], [49.85, 3.95], [49.35, 3.65], [48.85, 3.20], [48.70, 2.80], [48.95, 2.50], [49.10, 2.60]
      ], color: '#ef4444' },
      { name: '2<sup>e</sup> armée (von Bülow)', coords: [
        [50.45, 4.85], [50.00, 4.70], [49.60, 4.40], [49.20, 4.00], [48.95, 3.70], [48.75, 3.30]
      ], color: '#f87171' },
      { name: '3<sup>e</sup> armée (von Hausen)', coords: [
        [50.00, 5.20], [49.60, 5.00], [49.20, 4.70], [48.85, 4.35], [48.60, 4.00]
      ], color: '#fca5a5' },
    ];

    for (const route of germanRoutes) {
      L.polyline(route.coords, {
        color: route.color, weight: 3, opacity: 0.8, dashArray: '6, 4',
      }).addTo(map).bindTooltip(tooltip(`<strong style="color:${route.color}">${route.name}</strong>`), { sticky: true });
    }

    // ── French/British counter-movements ──
    const alliedRoutes = [
      { name: 'Armée française (Joffre)', coords: [
        [49.00, 2.30], [49.05, 2.55], [49.00, 2.85], [48.85, 3.20], [48.70, 3.50], [48.55, 3.80]
      ], color: '#3b82f6' },
      { name: 'BEF (French)', coords: [
        [50.10, 3.00], [49.90, 3.20], [49.70, 3.35], [49.50, 3.50], [49.30, 3.60]
      ], color: '#60a5fa' },
    ];

    for (const route of alliedRoutes) {
      L.polyline(route.coords, {
        color: route.color, weight: 3, opacity: 0.8,
      }).addTo(map).bindTooltip(tooltip(`<strong style="color:${route.color}">${route.name}</strong>`), { sticky: true });
    }

    // ── Trench line (after the Race to the Sea, late 1914) ──
    const trenchLine = [
      [51.10, 2.60], [50.80, 2.90], [50.50, 2.80], [50.30, 2.70], [49.90, 2.60],
      [49.50, 2.50], [49.30, 2.80], [49.00, 3.00], [48.50, 3.50], [48.00, 4.00],
      [47.50, 4.50], [47.00, 5.50], [46.50, 6.50],
    ];
    L.polyline(trenchLine, {
      color: '#78716c', weight: 2, opacity: 0.5, dashArray: '4, 4',
    }).addTo(map).bindTooltip(tooltip('<strong>Front stabilisé</strong><br>Ligne de tranchées (fin 1914)'), { className: 'map-tooltip' });

    // ── Key locations ──
    const locations = [
      { name: 'Paris', coords: [48.8566, 2.3522], desc: 'Objectif allemand. Capitale française sauvée par la bataille de la Marne.', type: 'city' },
      { name: 'Bruxelles', coords: [50.8503, 4.3517], desc: 'Entrée des Allemands le 20 août 1914.', type: 'city' },
      { name: 'Liège', coords: [50.6322, 5.5796], desc: 'Prise le 16 août 1914 par l\'armée allemande.', type: 'battle' },
      { name: 'Charleroi', coords: [50.4123, 4.4433], desc: 'Bataille de Charleroi (21-23 août 1914). Défaite française.', type: 'battle' },
      { name: 'Mons', coords: [50.4577, 3.9474], desc: 'Bataille de Mons (23-24 août 1914). Repli britannique.', type: 'battle' },
      { name: 'Marne', coords: [49.05, 3.20], desc: 'Bataille de la Marne (5-12 septembre 1914). Contre-offensive française qui sauve Paris.', type: 'battle' },
      { name: 'Sedan', coords: [49.7017, 4.9403], desc: 'Prise par les Allemands le 28 août 1914.', type: 'battle' },
      { name: 'Verdun', coords: [49.1597, 5.3826], desc: 'Bataille de Verdun en 1916 — symbole de la guerre d\'usure.', type: 'battle' },
    ];

    for (const loc of locations) {
      const color = loc.type === 'city' ? '#d4a843' : '#ef4444';
      const radius = loc.type === 'city' ? 8 : 6;
      L.circleMarker(loc.coords, {
        radius, color, weight: 2, fillColor: color, fillOpacity: 0.7,
      }).addTo(map)
        .bindTooltip(tooltip(`<strong style="color:${color}">${loc.name}</strong><br>${loc.desc}`), { sticky: true, className: 'map-tooltip' })
        .bindPopup(tooltip(`<strong style="color:${color}">${loc.name}</strong><br>${loc.desc}`));
    }

    // ── Legend ──
    const legendEl = document.getElementById('wwi-schlieffen-legend-content');
    if (legendEl) {
      legendEl.innerHTML = `
        <div style="display:flex;flex-direction:column;gap:0.25rem;font-size:0.8rem;">
          <span><span style="display:inline-block;width:12px;height:3px;background:#ef4444;margin-right:0.4rem;vertical-align:middle;"></span>Armées allemandes</span>
          <span><span style="display:inline-block;width:12px;height:3px;background:#3b82f6;margin-right:0.4rem;vertical-align:middle;"></span>Armées alliées</span>
          <span><span style="display:inline-block;width:12px;height:3px;background:#78716c;margin-right:0.4rem;vertical-align:middle;"></span>Ligne de front (fin 1914)</span>
          <span><span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:#d4a843;margin-right:0.4rem;vertical-align:middle;"></span>Ville</span>
          <span><span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:#ef4444;margin-right:0.4rem;vertical-align:middle;"></span>Bataille</span>
        </div>
      `;
    }
  })();
</script>

<style>
  :global(.map-tooltip) {
    background: #111827;
    border: 1px solid #1e293b;
    border-radius: 0.5rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
    color: #e2e8f0;
    font-size: 0.8rem;
    padding: 0.35rem 0.6rem;
    white-space: normal;
    max-width: 280px;
  }
  :global(.map-tooltip::before) { border-top-color: #1e293b; }
</style>
