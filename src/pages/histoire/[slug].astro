---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { getSource, formatSourceLabel } from '../../data/sources';
import { getMedia } from '../../data/media';
import MediaFigure from '../../components/MediaFigure.astro';
import EventMiniTimeline from '../../components/EventMiniTimeline.astro';

// ── Map script components (each provides Leaflet init for a [map:id] container) ──
import PrehistoricSitesMap from '../../components/PrehistoricSitesMap.astro';
import MigrationMap from '../../components/MigrationMap.astro';
import ResourceMap from '../../components/ResourceMap.astro';
import RomanProvincesMap from '../../components/RomanProvincesMap.astro';
import RomanCitiesMap from '../../components/RomanCitiesMap.astro';
import RomanWaterwaysMap from '../../components/RomanWaterwaysMap.astro';
import TreatyOfVerdunMap from '../../components/TreatyOfVerdunMap.astro';
import MedievalCitiesMap from '../../components/MedievalCitiesMap.astro';
import WWISchlieffenPlanMap from '../../components/WWISchlieffenPlanMap.astro';
import FranceOccupationMap from '../../components/FranceOccupationMap.astro';
import DdayLiberationMap from '../../components/DdayLiberationMap.astro';
import NapoleonBirthplaceMap from '../../components/NapoleonBirthplaceMap.astro';
import CoalitionCampaignMap from '../../components/CoalitionCampaignMap.astro';
import NapoleonExileMap from '../../components/NapoleonExileMap.astro';
import RevCommunesMap from '../../components/RevCommunesMap.astro';
import RevVarennesMap from '../../components/RevVarennesMap.astro';
import RevParisMap from '../../components/RevParisMap.astro';
import FirstColonialEmpireMap from '../../components/FirstColonialEmpireMap.astro';
import SecondColonialEmpireMap from '../../components/SecondColonialEmpireMap.astro';
import FrenchAlgeriaMap from '../../components/FrenchAlgeriaMap.astro';

// ── Widget components (non-map interactives) ──
import RevolutionBilan from '../../components/RevolutionBilan.astro';

// Registry: map ID → script component
const MAP_SCRIPTS = {
  'prehistoric': PrehistoricSitesMap,
  'migration': MigrationMap,
  'resources': ResourceMap,
  'roman-provinces': RomanProvincesMap,
  'roman-cities': RomanCitiesMap,
  'roman-waterways': RomanWaterwaysMap,
  'traite-verdun': TreatyOfVerdunMap,
  'villes-medievales': MedievalCitiesMap,
  'wwi-schlieffen': WWISchlieffenPlanMap,
  'france-occupation': FranceOccupationMap,
  'dday-liberation': DdayLiberationMap,
  'napoleon-naissance': NapoleonBirthplaceMap,
  'coalition-1814': CoalitionCampaignMap,
  'napoleon-exil': NapoleonExileMap,
  'rev-communes': RevCommunesMap,
  'rev-varennes': RevVarennesMap,
  'rev-paris': RevParisMap,
  'first-colonial-empire': FirstColonialEmpireMap,
  'second-colonial-empire': SecondColonialEmpireMap,
  'french-algeria': FrenchAlgeriaMap,
};

// Registry: widget ID → component
const WIDGETS = {
  'revolution-bilan': RevolutionBilan,
};

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map((entry) => ({
    params: { slug: entry.data.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const event = entry.data;
const { Content } = await entry.render();

// Extract inline source IDs from Markdown body
const sourceIds = [...new Set(
  [...entry.body.matchAll(/\[source:\s*([\w-]+)\]/g)].map((m) => m[1])
)];

const sources = (await Promise.all(
  sourceIds.map((id) => getSource(id)),
)).filter(Boolean);

// Hero media: first from mediaIds, fallback to mediaId
const allMediaIds = [...(event.mediaIds ?? []), ...(event.mediaId ? [event.mediaId] : [])];
const heroMediaId = allMediaIds[0];
const galleryMediaIds = allMediaIds.slice(1);

const heroMedia = heroMediaId ? await getMedia(heroMediaId) : undefined;
const galleryMedia = (await Promise.all(
  galleryMediaIds.map((id) => getMedia(id)),
)).filter(Boolean);
---

<Base title={`${event.title} — Histoire`} description={event.description ?? ''}>
  <article class="event-page">
    <header class="event-page__header">
      <a href="/histoire" class="event-page__back">← Chronologie</a>
      <time class="event-page__year">{event.yearDisplay}</time>
      <h1 class="event-page__title">{event.title}</h1>
    </header>

    {heroMedia && (
      <MediaFigure entry={heroMedia} variant="hero" />
    )}

    {galleryMedia.length > 0 && (
      <div class="event-page__gallery">
        {galleryMedia.map((m) => (
          <MediaFigure entry={m} variant="inline" />
        ))}
      </div>
    )}

    {event.timeline && event.timeline.length > 0 && (
      <EventMiniTimeline
        entries={event.timeline}
        eventStart={event.start}
        eventEnd={event.end}
      />
    )}

    <div class="event-page__body">
      <Content />

      {/*
        Map script components for [map:id] markers embedded inline.
        The HTML containers are generated by the remark-figure-embed plugin.
        Each script-only component provides the Leaflet initialization.
      */}
      {(event.maps ?? []).map((id) => {
        const Comp = MAP_SCRIPTS[id];
        return Comp ? <Comp /> : null;
      })}
    </div>

    {/*
      Widget components rendered after the body (typically at article end).
    */}
    {(event.widgets ?? []).map((id) => {
      const Comp = WIDGETS[id];
      return Comp ? <Comp /> : null;
    })}

    <footer class="event-page__footer">
      {sources.length > 0 && (
        <>
          <p class="event-page__sources-title">Sources</p>
          <ol class="event-page__sources-list">
            {sources.map((s) => (
              <li class="event-page__source-item">
                <a href={`/bibliographie/${s.id}`}>{formatSourceLabel(s)}</a>
              </li>
            ))}
          </ol>
        </>
      )}
    </footer>
  </article>
</Base>

<style>
  .event-page {
    max-width: 720px;
    margin: 0 auto;
    padding: var(--gap-xl) var(--gap-lg) var(--gap-2xl);
  }

  .event-page__back {
    display: inline-block;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    margin-bottom: var(--gap-lg);
    transition: color var(--transition-fast);
  }

  .event-page__back:hover {
    color: var(--color-link-on-dark);
  }

  .event-page__header {
    margin-bottom: var(--gap-xl);
  }

  .event-page__year {
    display: block;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--gap-sm);
  }

  .event-page__title {
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 5vw, 3rem);
    font-weight: 800;
    line-height: 1.1;
    color: var(--color-text-light);
    margin-bottom: var(--gap-md);
  }

  .event-page__gallery {
    display: flex;
    flex-direction: column;
    gap: var(--gap-lg);
    margin-bottom: var(--gap-lg);
    max-width: 720px;
  }

  .event-page__gallery :global(.figure) {
    margin: 0;
  }

  .event-page__body {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--color-text-light);
  }

  .event-page__body :global(h2) {
    margin-top: var(--gap-xl);
    margin-bottom: var(--gap-lg);
  }

  .event-page__body :global(h3) {
    margin-top: var(--gap-lg);
    margin-bottom: var(--gap-md);
  }

  .event-page__body :global(h2),
  .event-page__body :global(h3),
  .event-page__body :global(h4) {
    position: relative;                /* anchor for .heading-anchor */
  }

  .event-page__body :global(h2) {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 700;
    margin-top: var(--gap-xl);
    margin-bottom: var(--gap-md);
    color: var(--color-text-light);
  }

  .event-page__body :global(p) {
    margin-bottom: var(--gap-md);
  }

  .event-page__body :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    margin: var(--gap-lg) 0;
  }

  .event-page__body :global(ul), .event-page__body :global(ol) {
    margin-bottom: var(--gap-md);
    padding-left: var(--gap-lg);
  }

  .event-page__body :global(blockquote) {
    border-left: 3px solid var(--color-french-blue);
    padding-left: var(--gap-md);
    margin: var(--gap-lg) 0;
    color: var(--color-text-muted);
    font-style: italic;
  }

  /* ── Hidden heading anchors (from remark-heading-ids) ── */

  .event-page__body :global(.heading-anchor) {
    display: block;
    visibility: hidden;
    height: 0;
    width: 0;
    overflow: hidden;
    position: absolute;
    top: -80px;               /* offset for sticky nav */
    pointer-events: none;
  }

  /* ── Inline citation superscripts ── */

  .event-page__body :global(sup.citation) {
    font-size: 0.7em;
    vertical-align: super;
    line-height: 1;
  }

  .event-page__body :global(sup.citation a) {
    color: var(--color-link-on-dark);
    text-decoration: none;
    font-weight: 600;
  }

  .event-page__body :global(sup.citation a:hover),
  .event-page__body :global(sup.citation a:focus) {
    text-decoration: underline;
  }

  .event-page__body :global(sup.citation a:focus-visible) {
    outline: 2px solid var(--color-link-on-dark);
    outline-offset: 2px;
    border-radius: 2px;
  }

  /* ── Inline figure embeddings (from remark plugin) ── */

  .event-page__body :global(.chart-figure__container svg) {
    width: 100%;
    height: auto;
    max-width: 100%;
    display: block;
  }

  .event-page__body :global(.chart-figure__container) {
    padding: var(--gap-md) var(--gap-lg);
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 200px;
  }

  .event-page__body :global(.figure-warning) {
    padding: var(--gap-md);
    border: 1px dashed var(--color-french-red);
    border-radius: var(--radius-md);
    color: var(--color-french-red);
    font-size: 0.85rem;
    text-align: center;
    margin: var(--gap-lg) 0;
  }

  /* ── Map shell styles ── */

  .event-page__body :global(.map-shell) {
    width: 100%;
    max-width: 720px;
    margin: var(--gap-lg) auto;
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
  }

  .event-page__body :global(.map-shell__map) {
    width: 100%;
    height: 400px;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    overflow: hidden;
    background: #1e293b;
  }

  .event-page__body :global(.map-shell__noscript) {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    padding: var(--gap-lg);
    text-align: center;
  }

  .event-page__body :global(.map-shell__legend) {
    padding: var(--gap-md);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-card);
  }

  .event-page__body :global(.map-shell__legend-title) {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text-light);
    margin-bottom: var(--gap-xs);
  }

  .event-page__body :global(.map-shell__legend-hint) {
    font-size: 0.75rem;
    color: var(--color-accent-gold, #d4a843);
    font-style: italic;
    margin-bottom: var(--gap-sm);
  }

  .event-page__body :global(.map-shell__legend-content) {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    min-height: 3em;
  }

  .event-page__body :global(.map-shell__legend-placeholder) {
    font-style: italic;
  }

  .event-page__body :global(.map-shell__legend-site) {
    font-weight: 600;
    color: var(--color-text-light);
    margin-bottom: var(--gap-xs);
  }

  .event-page__body :global(.map-shell__legend-lieu) {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-bottom: var(--gap-xs);
  }

  .event-page__body :global(.map-shell__legend-age) {
    font-weight: 600;
    color: var(--color-accent-gold, #d4a843);
    margin-bottom: var(--gap-xs);
  }

  .event-page__body :global(.map-shell__legend-desc) {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  /* ── Footer sources list ── */

  .event-page__footer {
    margin-top: var(--gap-2xl);
    padding-top: var(--gap-lg);
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm);
    font-size: 0.85rem;
  }

  .event-page__sources-title {
    font-weight: 700;
    color: var(--color-text-light);
    margin-bottom: var(--gap-xs);
  }

  .event-page__sources-list {
    padding-left: var(--gap-lg);
    margin: 0;
    list-style: decimal;
  }

  .event-page__source-item {
    margin-bottom: var(--gap-xs);
    line-height: 1.5;
  }

  .event-page__source-item a {
    color: var(--color-link-on-dark);
    text-decoration: none;
  }

  .event-page__source-item a:focus-visible {
    outline: 2px solid var(--color-link-on-dark);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .event-page__source-item a:hover {
    text-decoration: underline;
  }
  /* ── Chart tooltips ── */

  .chart-figure__container :global(.tippy-box[data-theme~='chart']) {
    background-color: #0f172a;
    border: 1px solid #334155;
    border-radius: 6px;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: #e2e8f0;
    padding: 0.25rem 0;
  }

  .chart-figure__container :global(.tippy-box[data-theme~='chart'] .tippy-content) {
    padding: 0.375rem 0.75rem;
  }

  .chart-figure__container :global(.tippy-box[data-theme~='chart'] .tippy-arrow) {
    color: #334155;
  }

  .chart-figure__container :global(.tippy-box[data-theme~='chart'] .tt-label) {
    font-weight: 700;
    color: #f1f5f9;
  }

  .chart-figure__container :global(.tippy-box[data-theme~='chart'] .tt-row) {
    display: flex;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .chart-figure__container :global(.tippy-box[data-theme~='chart'] .tt-field) {
    color: #94a3b8;
  }

  .chart-figure__container :global(.tippy-box[data-theme~='chart'] .tt-value) {
    color: #e2e8f0;
    font-weight: 600;
  }
</style>

<script>
  import tippy from 'tippy.js';
  import 'tippy.js/dist/tippy.css';

  document.addEventListener('DOMContentLoaded', () => {
    // Target only data marks (paths, circles, rects) inside chart figures.
    // Vega also adds aria-label to axes and legends — those contain words
    // like "axis" or "Legend" and should not get interactive tooltips.
    const marks = Array.from(
      document.querySelectorAll('.chart-figure [aria-label]')
    ).filter((el) => {
      const label = el.getAttribute('aria-label') || '';
      return !/axis|scale|Legend|symbol/i.test(label);
    });

    if (!marks.length) return;

    tippy(marks, {
      theme: 'chart',
      placement: 'top',
      arrow: true,
      allowHTML: true,
      interactive: false,
      appendTo: () => document.body,
      content(ref) {
        const raw = ref.getAttribute('aria-label');
        if (!raw) return '';

        // Parse "key: value; key2: value2" pairs into labeled rows
        const pairs = raw.split('; ').map((pair) => {
          const colon = pair.indexOf(': ');
          if (colon === -1) return { field: '', value: pair };
          return {
            field: pair.slice(0, colon),
            value: pair.slice(colon + 2),
          };
        });

        // Build HTML — skip the first raw "value: N" pair which is redundant
        // (already shown as the last "Valeur" or "value" row)
        const deduped = [];
        const seen = new Set();
        for (const p of pairs) {
          const key = p.field.toLowerCase().replace(/[^a-z]/g, '');
          if (!p.field || seen.has(key)) continue;
          seen.add(key);
          deduped.push(p);
        }

        const rows = deduped
          .map(
            (p) =>
              `<div class="tt-row"><span class="tt-field">${p.field}</span> <span class="tt-value">${p.value}</span></div>`
          )
          .join('');

        return rows;
      },
    });
  });
</script>
